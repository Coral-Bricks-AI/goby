# Image-owned budget defaults for one code run.
#
# The entrypoint sources this file, then a workflow variable of the same name wins — same
# convention as review/defaults.env, so a change here reaches every consumer through `:latest`.
: "${GOBY_CODE_MAX_ROUNDS:=3}"
: "${GOBY_THINKING:=high}"
: "${GOBY_MAX_TURNS:=80}"
: "${GOBY_MAX_TOOL_CALLS:=150}"
# The agent's own wall clock, in seconds. Higher than the reviewer's: this agent edits files and
# runs tests/builds to check its own work, not just reads them.
: "${GOBY_AGENT_TIMEOUT_S:=1200}"
: "${GOBY_BASH_TIMEOUT_S:=180}"
export GOBY_CODE_MAX_ROUNDS GOBY_MAX_TURNS GOBY_MAX_TOOL_CALLS GOBY_AGENT_TIMEOUT_S GOBY_BASH_TIMEOUT_S
export GOBY_THINKING
