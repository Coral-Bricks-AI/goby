# Image-owned budget defaults for one review.
#
# The entrypoint sources this file, then a workflow variable of the same name wins. Keeping the
# numbers here is what lets a change reach every consumer through `:latest` instead of a workflow
# edit in each repository; a workflow sets one only to override it.
: "${GOBY_MAX_ROUNDS:=1}"
: "${GOBY_MAX_TURNS:=50}"
: "${GOBY_MAX_TOOL_CALLS:=80}"
# The agent's own wall clock, in seconds — the bound a turn cap cannot supply. A turn cap is not a
# clock: 50 turns at a slow provider's latency took 14.5 minutes, the runner killed the job at its
# `timeout-minutes` before the review reached a verdict, and the statuses `prepare` had posted stayed
# pending. So this number sits well inside the shipped workflow's 15 minutes, leaving the clone, the
# diff and the publish their time.
: "${GOBY_AGENT_TIMEOUT_S:=600}"
: "${GOBY_BASH_TIMEOUT_S:=120}"
: "${GOBY_MAX_DIFF_LINES:=10000}"
: "${GOBY_MAX_FINDINGS:=30}"
export GOBY_MAX_ROUNDS GOBY_MAX_TURNS GOBY_MAX_TOOL_CALLS GOBY_AGENT_TIMEOUT_S GOBY_BASH_TIMEOUT_S
export GOBY_MAX_DIFF_LINES GOBY_MAX_FINDINGS
