# Image-owned defaults for one scan.
#
# The entrypoint sources this file, then a workflow variable of the same name wins. Keeping the
# numbers here is what lets a change reach every client through `:latest` instead of a workflow
# edit in each repository; a workflow sets one only to override it.
: "${MAX_TOOLS:=200}"
: "${ISSUES_PER_DAY:=25}"
: "${MAX_COMPONENTS:=4}"
# pi's default is `medium`. Stated here so the level is this image's decision rather than one
# it inherits from a dependency, and so raising it is one line that reaches every client.
: "${THINKING:=high}"

export THINKING MAX_TOOLS ISSUES_PER_DAY MAX_COMPONENTS
